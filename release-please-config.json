{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "pull-request-title-pattern": "chore(release):${component} ${version}",
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["gea"],
      "extra-files": [
        { "type": "toml", "path": "crates/fjo/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==='fjo')].version" }
      ],
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "include-v-in-release-name": true
    },
    "gea": {
      "component": "gea",
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "crates/gea/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==='gea')].version" }
      ],
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "include-v-in-release-name": true,
      "last-release-sha": "baa9bf8020e6a0fc32f455a64276c2b4bd5db734"
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "refactor", "section": "Code Refactoring" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation" },
    { "type": "style", "section": "Styles" },
    { "type": "test", "section": "Tests" },
    { "type": "build", "section": "Build System" },
    { "type": "ci", "section": "Continuous Integration" },
    { "type": "chore", "section": "Miscellaneous Chores" },
    { "type": "deps", "section": "Dependencies" }
  ]
}
